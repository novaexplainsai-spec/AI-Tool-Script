# Product Hunt API token (free) - get it at https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=your_producthunt_developer_token_here

# Groq API key (free tier) - get it at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Which model to use on Groq's free tier (llama-3.3-70b-versatile is a solid free default)
GROQ_MODEL=llama-3.3-70b-versatile
